# Environment Configuration Template for NLPHire
# Copy this file to .env for local environment setup

# Flask Secret Key for Session Signing & CSRF Token Validation
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Database Connection URI (Supports SQLite for dev and PostgreSQL for production)
DATABASE_URL=sqlite:///resume.db

# Optional: Google Gemini API Key for AI Feedback Generation Tier
# If omitted or invalid, the system automatically falls back to grounded rule-based feedback.
GEMINI_API_KEY=your_gemini_api_key_here

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
